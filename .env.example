# 复制为 .env.local 后填写（.env.local 已被 .gitignore 忽略）
# Supabase Dashboard → Project Settings → API Keys / Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# 只能填 publishable key（sb_publishable_...），绝不能填 secret / service_role key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
